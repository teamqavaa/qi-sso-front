# Base URL of the courses-api Django service
COURSES_API_URL=http://localhost:8000

# Base URL of the pratice-lab coding workspace (lab cards link here)
NEXT_PUBLIC_PRACTICE_LAB_URL=http://localhost:3002

# courses-api signs and validates the JWTs. Set the same SSO_JWT_SECRET value
# that courses-api uses (see courses-api/.sso-jwt-secret).
SSO_JWT_SECRET=
